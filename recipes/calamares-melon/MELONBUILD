pkgname=calamares-melon
pkgver=0.1
pkgrel=9
pkgdesc="melon's Calamares setup: branding, job configs and finishing scripts (live ISO only)"
license=GPL-3.0-or-later
depends=(calamares)
builddir=$srcdir
package(){
  cp -a $startdir/files/. $pkgdir/
  mkdir -p $pkgdir/usr/share/calamares/branding
  cp -a $startdir/branding/melon $pkgdir/usr/share/calamares/branding/
  chmod 755 $pkgdir/usr/bin/* $pkgdir/usr/libexec/melon/cal-* $pkgdir/usr/libexec/melon/cal-shims/*; }
