#!/bin/bash
# valence-build-recipe: build ONE recipe into signed apk v3 packages, in a sysroot that holds what the recipe
# declares and nothing else. This is the step scripts/valence-build runs for each recipe, in the order it works out
# from the recipes; use that, unless everything this recipe needs is known to be in the repository already.
# usage: valence-build-recipe <recipe-name>
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/env.sh"
APK=$M/hosttools/bin/apk
KEY=${VALENCE_SIGN_KEY:-$M/keys/valence-signing.rsa}   # VALENCE_SIGN_KEY: a key rotation (AGENTS.md), or the everyday key kept on a USB stick and used in place (BUILDING.md); mkiso.sh reads it too
ARCH=$APK_ARCH
OUT=$REPO/$ARCH
mkdir -p "$OUT" "$WORK"
# Bump when a change to this script alters what packages contain: scripts/valence-build then builds every recipe again.
BUILD_EPOCH=2
# What every build may use without naming it: the C library with its headers (and the kernel's), and the compiler's
# runtime libraries, which a program that a build makes and then runs is started with (scripts/valence-run).
BUILD_BASE="glibc-dev libgcc libstdc++"

name=$1
# one sysroot per checkout and architecture, so one build at a time
exec 8>"$WORK/.build.lock"
flock -n 8 || { echo "valence-build-recipe: another build is running in this checkout ($WORK/.build.lock)"; exit 1; }
RECIPE=$M/recipes/$name/VALENCEBUILD
[ -f "$RECIPE" ] || { echo "no recipe $RECIPE"; exit 1; }

msg(){ printf '\033[1;32m>>> %s:\033[0m %s\n' "$name" "$*"; }

# ---------- defaults a recipe may override ----------
pkgrel=0; depends=(); makedepends=(); subpackages=(); source=(); license=unknown; url=; options=()
prepare(){ :; }
build(){ :; }
check(){ :; }

# cross-compile environment
export CC="$TARGET-gcc" CXX="$TARGET-g++" AR="$TARGET-ar" AS="$TARGET-as" LD="$TARGET-ld"
export NM="$TARGET-nm" RANLIB="$TARGET-ranlib" STRIP="$TARGET-strip" OBJCOPY="$TARGET-objcopy"
export READELF="$TARGET-readelf" OBJDUMP="$TARGET-objdump"
export CFLAGS="-O2 -pipe -fstack-clash-protection -fno-plt -Wformat -Werror=format-security"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-Wl,--as-needed,-O1,--sort-common,-z,relro,-z,now"
export PKG_CONFIG_SYSROOT_DIR=$SYSROOT
export PKG_CONFIG_LIBDIR=$SYSROOT/usr/lib/pkgconfig:$SYSROOT/usr/share/pkgconfig
export PKG_CONFIG_PATH=
# msgfmt finds ITS rules (polkit, gschema, ...) installed by earlier Valence packages
export GETTEXTDATADIRS=$SYSROOT/usr/share/gettext:/usr/share/gettext
export CONFIG_SITE=$M/scripts/config.site
# CMake 4 (Valence's, on a Valence build machine) refuses cmake_minimum_required below 3.5 (libjpeg-turbo, yaml-cpp); this
# raises those to 3.5. CMake 3.x (Ubuntu's) ignores it.
export CMAKE_POLICY_VERSION_MINIMUM=3.5
# programs a build compiles for the build machine (CC_FOR_BUILD: flex's stage1flex, gnulib's rpl_malloc) get the C
# dialect Ubuntu's GCC 13 defaults to: Valence's GCC 15 defaults to C23, where old `void *malloc ();` is "no arguments"
# (rule 40). Ubuntu builds keep autoconf's default.
[ "$VALENCE_HOST" = valence ] && export CFLAGS_FOR_BUILD="-g -O2 -std=gnu17"
# build systems that ask git for "their" revision (clang --version, Rust build scripts) must not find Valence's own
# checkout above the source tree: git stops looking at $WORK
export GIT_CEILING_DIRECTORIES=$WORK
CHOST=$TARGET CBUILD=$BUILD_TRIPLE   # env.sh: never equal to $TARGET, even on Valence
export CHOST CBUILD
conf_flags="--host=$CHOST --build=$CBUILD --prefix=/usr --sysconfdir=/etc --localstatedir=/var --mandir=/usr/share/man --infodir=/usr/share/info --libdir=/usr/lib --bindir=/usr/bin --sbindir=/usr/bin --libexecdir=/usr/libexec"

# meson cross file
mkdir -p "$WORK"   # a fresh checkout has no work/ yet
MESON_CROSS=$WORK/meson-cross.ini
cat > $MESON_CROSS <<EOF
[binaries]
c = '$TARGET-gcc'
cpp = '$TARGET-g++'
ar = '$TARGET-ar'
strip = '$TARGET-strip'
llvm-config = '$SYSROOT/usr/bin/llvm-config'
pkg-config = 'pkg-config'
# programs built for Valence run through Valence's loader and libraries, not the build machine's (scripts/valence-run)
exe_wrapper = '$M/scripts/valence-run'
# Qt's code generators must be the host builds (rule 20); for cross builds meson only finds them here, never on PATH
moc = '$M/hosttools/qt6/libexec/moc'
uic = '$M/hosttools/qt6/libexec/uic'
rcc = '$M/hosttools/qt6/libexec/rcc'
lrelease = '$M/hosttools/qt6/bin/lrelease'
lupdate = '$M/hosttools/qt6/bin/lupdate'
qmlcachegen = '$M/hosttools/qt6/libexec/qmlcachegen'
qmltyperegistrar = '$M/hosttools/qt6/libexec/qmltyperegistrar'
# the sandbox helper projects compile in; Valence's lives here (the build host needs one too for meson's check)
bwrap = '/usr/bin/bwrap'
# Rust (scripts/host-rust.sh): for Valence's target, linked by Valence's gcc and dynamically against its libc
rust = ['$M/hosttools/rust/bin/rustc', '--target', '$RUST_TARGET', '-C', 'linker=$TARGET-gcc', '-C', 'target-feature=-crt-static']
[properties]
needs_exe_wrapper = true
sys_root = '$SYSROOT'
pkg_config_libdir = '$PKG_CONFIG_LIBDIR'
[host_machine]
system = 'linux'
cpu_family = '$MESON_CPU_FAMILY'
cpu = '$MESON_CPU'
endian = 'little'
EOF
export MESON_CROSS
# cmake toolchain file
CMAKE_TC=$WORK/cmake-toolchain.cmake
cat > $CMAKE_TC <<EOF
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR $MESON_CPU)
set(CMAKE_C_COMPILER $TARGET-gcc)
set(CMAKE_CXX_COMPILER $TARGET-g++)
set(CMAKE_SYSROOT $SYSROOT)
set(CMAKE_FIND_ROOT_PATH $SYSROOT)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CROSSCOMPILING_EMULATOR $M/scripts/valence-run)
EOF
export CMAKE_TC
cmake_setup(){ cmake -G Ninja -DCMAKE_TOOLCHAIN_FILE="$CMAKE_TC" -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
  -DCMAKE_INSTALL_SBINDIR=bin -DCMAKE_INSTALL_LIBEXECDIR=libexec -DCMAKE_INSTALL_SYSCONFDIR=/etc -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_TESTING=OFF "$@"; }
# CMake configured as a *native* build with Valence's compilers and sysroot: CMake doesn't know it is cross-compiling,
# so the programs a build makes and runs (clang's tablegen, generators) are started directly. They can be, because
# the recipe has options=(runhere) and this passes its link flags to CMake (rule 18). recipes/clang, libclc.
cmake_native(){ has_opt runhere || { msg "cmake_native needs options=(runhere)"; exit 1; }
  cmake -G Ninja -DCMAKE_C_COMPILER=$TARGET-gcc -DCMAKE_CXX_COMPILER=$TARGET-g++ -DCMAKE_SYSROOT=$SYSROOT \
  -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS $RUNHERE_LDFLAGS" -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS $RUNHERE_LDFLAGS" \
  -DCMAKE_MODULE_LINKER_FLAGS="$LDFLAGS $RUNHERE_LDFLAGS" \
  -DCMAKE_FIND_ROOT_PATH=$SYSROOT -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
  -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY -DCMAKE_INSTALL_PREFIX=/usr \
  -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS="$CFLAGS" -DCMAKE_CXX_FLAGS="$CXXFLAGS" "$@"; }
# the cross file supplies the target pkg-config settings; the environment is left to native (build-host) lookups
meson_setup(){ local args=(); while IFS= read -r -d '' a; do args+=("$a"); done < <(python3 $M/scripts/meson-filter-opts.py "$@"; printf '\0')
  env -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_SYSROOT_DIR -u PKG_CONFIG_PATH meson setup --cross-file "$MESON_CROSS" --prefix=/usr --libdir=lib --sbindir=bin --libexecdir=libexec --sysconfdir=/etc --localstatedir=/var --buildtype=release -Db_lto=false "${args[@]}"; }

# pure-Python modules (no C parts): copied into python3's site-packages with a small .dist-info (importlib.metadata
# finds them by it). py_install <distribution name> <package dirs or .py files, relative to the source tree>...
py_install(){ local name=$1 py site di; shift; py=$(cd $SYSROOT/usr/lib && ls -d python3.* | sort -V | tail -1)
  site=$pkgdir/usr/lib/$py/site-packages; install -d $site; cp -r "$@" $site/
  find $site -name __pycache__ -prune -exec rm -rf {} +
  di=$site/$(printf '%s' "$name" | tr 'A-Z.-' 'a-z__')-$pkgver.dist-info; install -d $di
  printf 'Metadata-Version: 2.1\nName: %s\nVersion: %s\n' "$name" "$pkgver" > $di/METADATA; echo valence > $di/INSTALLER; }

# Rust (scripts/host-rust.sh, AGENTS.md rule 46). Cargo builds for $RUST_TARGET with the build machine's Rust and
# Valence's gcc as the linker. On x86_64 that target is also the build machine's own triple, so cargo has one set of
# compiler and linker settings for two kinds of output: Valence's programs, and what runs on the build machine while
# they are built (build scripts, proc-macros, and the C code their crates compile for themselves). They are told
# apart by where they are written: cargo puts the target's files under <triple>/release and the build machine's
# under release. $WORK/rust-cc/{cc,c++} look at that and run Valence's compiler or the build machine's.
# Crates come from crates.io into sources/cargo, pinned by the checksums in the project's Cargo.lock: cargo_fetch in
# prepare(), cargo_build builds offline.
[ -x $M/hosttools/rust/bin/cargo ] && export PATH=$M/hosttools/rust/bin:$PATH
_rt=${RUST_TARGET//-/_}; _RT=${_rt^^}
export CARGO_HOME=$SRC/cargo CARGO_TERM_COLOR=never CARGO_TERM_PROGRESS_WHEN=never PKG_CONFIG_ALLOW_CROSS=1
rust_cc(){ # rust_cc DIR [link flags for Valence's programs]: writes DIR/cc and DIR/c++
  local dir=$1 extra=${2:-} n cross host; mkdir -p $dir
  for n in cc c++; do
    if [ $n = cc ]; then cross=$TARGET-gcc host=gcc; else cross=$TARGET-g++ host=g++; fi
    cat > $dir/$n <<WRAP
#!/bin/sh
for a in "\$OUT_DIR" "\$@"; do
  case \$a in */$RUST_TARGET/release/*|*/$RUST_TARGET/debug/*) exec $cross "\$@" $extra ;; esac
done
exec $host "\$@"
WRAP
    chmod +x $dir/$n
  done; }
rust_cc $WORK/rust-cc
export "CARGO_TARGET_${_RT}_LINKER=$WORK/rust-cc/cc" "CC_$_rt=$WORK/rust-cc/cc" "CXX_$_rt=$WORK/rust-cc/c++" "AR_$_rt=$TARGET-ar"
need_rust(){ command -v cargo >/dev/null || { echo "no host Rust: run scripts/host-rust.sh" >&2; exit 1; }; }
cargo_fetch(){ need_rust; cargo fetch --locked --target $RUST_TARGET "$@"; }
# (--target is given even where it is the build machine's own triple: without it cargo makes no difference between
# the two kinds of output, and the build scripts would be Valence programs)
cargo_build(){ need_rust; CARGO_NET_OFFLINE=true cargo build --release --locked --target $RUST_TARGET "$@"; }
# where cargo_build leaves the binaries
cargo_out(){ echo target/$RUST_TARGET/release; }

srcdir=$WORK/pkg/$name/src
pkgbase=$WORK/pkg/$name/pkg
. "$RECIPE"
pkgdir=$pkgbase/$pkgname
: "${builddir:=$srcdir/$pkgname-$pkgver}"
startdir=$M/recipes/$name
export srcdir pkgdir builddir startdir pkgname pkgver

# unpack a source tarball. .xz goes through xz itself: BusyBox's tar (Valence as the build machine) decodes xz only up to a
# 64 MiB dictionary, and Rust's release tarballs use 128 MiB ("tar: corrupted data"). Recipes can call it too.
untar(){ case $1 in *.xz|*.txz) xz -dc "$1" | tar -xf - -C "${2:-.}";; *) tar -xf "$1" -C "${2:-.}";; esac; }
has_opt(){ local o; for o in "${options[@]:-}"; do [ "$o" = "$1" ] && return 0; done; return 1; }

# ---------- programs that have to run where they are built (rule 18) ----------
# options=(runhere) is for a build that runs what it has just built and cannot be handed a wrapper for it: perl's
# Configure and its miniperl, bc's fbc, file compiling its magic. Everything the recipe links is told to start
# through the sysroot's loader and to look for libraries in the sysroot: the loader's path goes into it as the
# program interpreter, the sysroot's library directory as an RPATH (the old kind, which also holds for what those
# libraries need in turn). Its programs then run on the build machine like the machine's own. normalise() takes
# both out of every file again before a package is made, and no package is made that still has either.
# CMake and meson builds do not need this: they start built programs through scripts/valence-run by themselves.
case $APK_ARCH in x86) SYSTEM_INTERP=/lib/$LDSO ;; *) SYSTEM_INTERP=/lib64/$LDSO ;; esac
RUNHERE_LDFLAGS="-Wl,--dynamic-linker=$SYSROOT/usr/lib/$LDSO -Wl,--disable-new-dtags -Wl,-rpath,$SYSROOT/usr/lib"
if has_opt runhere; then export CC="$CC $RUNHERE_LDFLAGS" CXX="$CXX $RUNHERE_LDFLAGS" RUNHERE_LDFLAGS; fi

# ---------- the sysroot: what this recipe declares, and nothing else ----------
# Every build starts with a sysroot that holds $BUILD_BASE and the recipe's makedepends, with the packages those
# depend on, and no other package: a library the recipe does not name is not there to be found, so the same recipe
# makes the same package whatever was built before it (ROADMAP.md, "Decided": clean builds). apk works out the
# difference from the sysroot the last build left, so only what differs is unpacked or removed; "upgrade --available"
# also replaces a package that was rebuilt without a new version.
# options=(bootstrap) is for the recipes the build base itself is made from. They are built before the base exists
# as packages, on the C library scripts/toolchain.sh put into the sysroot: their sysroot is left as it is, and only
# their own makedepends are added.
apk_sysroot(){ flock $OUT/.lock $APK --root $SYSROOT --arch $ARCH --keys-dir $M/keys/trusted --repositories-file /dev/null \
       --repository $OUT/Packages.adb --no-scripts --no-cache --quiet "$@"; }
[ -d $SYSROOT/lib/apk/db ] || $APK --root $SYSROOT --arch $ARCH --initdb --keys-dir $M/keys/trusted \
  --repositories-file /dev/null add >/dev/null 2>&1 || true
if has_opt bootstrap; then
  msg "sysroot (bootstrap, left as it is): ${makedepends[*]:-nothing added}"
  [ ${#makedepends[@]} -eq 0 ] || apk_sysroot add --upgrade "${makedepends[@]}"
else
  msg "sysroot: $BUILD_BASE ${makedepends[*]:-}"
  mkdir -p $SYSROOT/etc/apk
  printf '%s\n' $BUILD_BASE "${makedepends[@]:-}" | grep . | sort -u > $SYSROOT/etc/apk/world
  apk_sysroot upgrade --available --no-self-upgrade || {
    echo "$name: the sysroot could not be set up: a makedepends that no package in the repository provides?"; exit 1; }
fi

# ---------- programs in the sysroot can be run on the build machine ----------
# A program in the sysroot was built for Valence: it wants Valence's loader and libraries, and the build machine's
# own are older ones (scripts/valence-run). Builds run such programs all the time without saying so: CMake starts an
# imported tool directly (KDE's kconfig_compiler; CMAKE_CROSSCOMPILING_EMULATOR is only put in front of programs
# the same build made), meson a program it found through pkg-config (wayland-scanner), a configure script whatever
# it found. On Melon they simply ran, because musl's loader had a name of its own. So every dynamically linked
# program in the sysroot's program directories is put aside under $SYSROOT/.real and replaced by a two-line script
# that starts it through Valence's loader, under its own name (--argv0). This is the sysroot only, done again for
# every build; packages are not touched.
wrap_sysroot_programs(){
  local d f real elf; elf=$(printf '\177ELF')
  for d in usr/bin usr/libexec usr/lib/qt6/bin usr/lib/qt6/libexec; do
    [ ! -d "$SYSROOT/$d" ] || find "$SYSROOT/$d" -type f -perm -u+x 2>/dev/null
  done | while IFS= read -r f; do
    [ "$(head -c 4 "$f" 2>/dev/null)" = "$elf" ] || continue
    $READELF -l "$f" 2>/dev/null | grep -q INTERP || continue      # (a static program runs as it is)
    real=$SYSROOT/.real${f#$SYSROOT}
    mkdir -p "${real%/*}" && cp -p "$f" "$real.tmp" && mv "$real.tmp" "$real" || continue
    printf '#!/bin/sh\nexec %s --library-path %s --argv0 "$0" %s "$@"\n' "$SYSROOT/usr/lib/$LDSO" "$SYSROOT/usr/lib" "$real" > "$f.wrap.tmp"
    chmod --reference="$f" "$f.wrap.tmp"; mv "$f.wrap.tmp" "$f"
  done
  # what was put aside for programs that have left the sysroot since
  [ ! -d $SYSROOT/.real ] || find $SYSROOT/.real -type f | while IFS= read -r real; do
    [ -e "$SYSROOT${real#$SYSROOT/.real}" ] || rm -f "$real"; done
}
wrap_sysroot_programs

# ---------- fetch / unpack ----------
# VALENCE_KEEP_SRC=1 resumes a failed build in the existing tree (no unpack, no patches, no prepare)
# VALENCE_AUTO_RESUME=1 resumes by itself when an earlier run got past "prepare" (container restarts), but only with
# the same recipe and patches: a fix pulled since then must unpack fresh, or its patches and prepare() never run
recipe_sum=$(for f in "$startdir"/VALENCEBUILD "$startdir"/*.patch; do [ ! -f "$f" ] || cat "$f"; done | sha256sum | cut -d' ' -f1)
[ "${VALENCE_AUTO_RESUME:-0}" = 1 ] && [ "$(cat "$WORK/pkg/$name/.prepared" 2>/dev/null)" = "$recipe_sum" ] && VALENCE_KEEP_SRC=1
if [ "${VALENCE_KEEP_SRC:-0}" = 1 ] && [ -d "$srcdir" ]; then
  msg "reusing existing source tree"; rm -rf "$pkgbase"; mkdir -p "$pkgdir"; KEEP=1
else
KEEP=0
rm -rf "$WORK/pkg/$name"; mkdir -p "$srcdir" "$pkgdir"
for s in "${source[@]:-}"; do
  [ -z "$s" ] && continue
  if [ -f "$startdir/$s" ]; then cp "$startdir/$s" "$srcdir/"; continue; fi
  f=$SRC/$s; [ -e "$f" ] || { echo "missing source $f"; exit 1; }
  case $s in *.tar*|*.tgz) msg "unpack $s"; untar "$f" "$srcdir";; *) cp "$f" "$srcdir/";; esac
done
cd "$srcdir"; [ -d "$builddir" ] && cd "$builddir"
# apply patches shipped with the recipe
for p in "$startdir"/*.patch; do [ -f "$p" ] || continue; msg "patch $(basename $p)"; patch -p1 -s < "$p"; done
msg prepare; prepare
echo "$recipe_sum" > "$WORK/pkg/$name/.prepared"
fi
cd "$builddir" 2>/dev/null || cd "$srcdir"
msg build; build
cd "$builddir" 2>/dev/null || cd "$srcdir"
msg package; package
# pkg-config answers carry the sysroot (-L$SYSROOT/usr/lib), and build systems copy them into their own .pc files
# (Libs.private): on the target those are plain /usr paths
for f in "$pkgdir"/usr/lib/pkgconfig/*.pc "$pkgdir"/usr/share/pkgconfig/*.pc; do
  [ -f "$f" ] && grep -q "$SYSROOT" "$f" && sed -i -e "s| -L$SYSROOT/usr/lib\b||g; s| -I$SYSROOT/usr/include\b||g; s|$SYSROOT/|/|g" "$f"
done
# cross-build safety net: some builds install under build-machine paths (pkg-config puts the sysroot in front of
# path variables; the host Qt reports its own qml/plugins dirs). Move such files to where they belong, and report
# files that have a build-machine path compiled in (those need a fix in the recipe).
_relocate(){ [ -d "$pkgdir$1" ] || return 0; msg "LEAK: files installed under $1, moved to $2"
  mkdir -p "$pkgdir$2"; cp -a "$pkgdir$1/." "$pkgdir$2/"; rm -rf "$pkgdir$1"; }
_relocate "$SYSROOT" /
_relocate "$M/hosttools/qt6/qml" /usr/lib/qt6/qml
_relocate "$M/hosttools/qt6/plugins" /usr/lib/qt6/plugins
[ -d "$pkgdir${M%/*}" ] && find "$pkgdir${M%%/${M#/*/}}" -depth -type d -empty -delete 2>/dev/null || true
# (no --exclude: BusyBox grep, on a Valence build machine, has none)
grep -rlaE "$SYSROOT/(usr/(share|lib|libexec|bin)|etc)|$M/hosttools" "$pkgdir" 2>/dev/null | grep -v '\.la$' | sed "s|^$pkgdir||" | while read -r f; do
  msg "LEAK: build-machine path compiled into $f"; done || true

varname(){ printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_'; }
# ---------- subpackage helpers ----------
# move path(s) relative to pkgdir into subpkgdir
amove(){ local p; for p in "$@"; do
  p=${p#/}; for m in $pkgdir/$p; do [ -e "$m" ] || [ -L "$m" ] || continue
    local rel=${m#$pkgdir/}; mkdir -p "$subpkgdir/$(dirname "$rel")"; mv "$m" "$subpkgdir/$rel"; done; done; }
default_dev(){
  amove usr/include usr/lib/pkgconfig usr/share/pkgconfig usr/lib/cmake usr/share/aclocal 'usr/lib/*.a'
  local l; for l in $pkgdir/usr/lib/*.so; do [ -L "$l" ] && amove "usr/lib/$(basename $l)"; done; true; }
# docs and translations are never deleted and never ride along in the program's own package (ROADMAP phase 3):
# what a recipe leaves in these directories ends up in <pkg>-doc and <pkg>-lang (see "docs and translations" below).
# usr/share/info/dir is the index every Texinfo package would ship its own copy of.
default_doc(){ amove usr/share/man usr/share/info usr/share/doc usr/share/gtk-doc usr/share/help
  rm -f "$subpkgdir/usr/share/info/dir"; }
default_lang(){ amove usr/share/locale; }

# ---------- normalise: merged /usr ----------
normalise(){ local d=$1
  for x in bin sbin usr/sbin; do [ -d "$d/$x" ] && [ ! -L "$d/$x" ] && { mkdir -p "$d/usr/bin"; cp -a "$d/$x/." "$d/usr/bin/"; rm -rf "$d/$x"; }; done
  [ -d "$d/lib" ] && [ ! -L "$d/lib" ] && { mkdir -p "$d/usr/lib"; cp -a "$d/lib/." "$d/usr/lib/"; rm -rf "$d/lib"; }
  find "$d" -name '*.la' -delete
  # absolute library and header links (keyutils: libkeyutils.so -> /usr/lib/...) would point into the build
  # machine's own /usr from the sysroot: make them relative, by name only, never through the host's links
  # (os.path.relpath, as GNU realpath -s -m --relative-to; BusyBox realpath on a Valence build machine has no options)
  find "$d/usr/lib" "$d/usr/include" -type l 2>/dev/null | while read -r l; do
    t=$(readlink "$l"); case $t in /usr/*) ln -sfn "$(python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' \
      "$t" "$(dirname "${l#$d}")")" "$l";; esac; done || true
  # options=(runhere): the sysroot's loader and library path come out of everything that was linked with them
  # (its list goes to a file: piped into head, a long one would end the tool half-way through)
  if has_opt runhere; then python3 $M/scripts/elf-unbake.py "$SYSROOT" "$SYSTEM_INTERP" "$d" > $WORK/unbake.log
    [ ! -s $WORK/unbake.log ] || msg "runhere: the sysroot's loader or library path taken out of $(cut -d: -f2 $WORK/unbake.log | sort -u | wc -l) files"; fi
  if ! has_opt '!strip'; then
    find "$d" -type f \( -perm -u+x -o -name '*.so*' \) 2>/dev/null | while read -r f; do
      case $(file -b "$f") in *ELF*relocatable*) ;; *ELF*) $STRIP --strip-unneeded "$f" 2>/dev/null || true;; esac; done
  fi
  has_opt keepdirs || find "$d" -depth -type d -empty -delete 2>/dev/null || true
  mkdir -p "$d"
  # files copied with cp -a from the checkout (a recipe's files/) keep the builder's own account; apk records its
  # name, and a system without that account gets them as nobody (rule 45). Root owns them; system accounts a recipe
  # chose on purpose (uid/gid below 1000: cups' lp, dbus' messagebus) stay.
  # (stat, not find -uid/-gid: BusyBox find on a Valence build machine has neither; stat -c reads the link itself, like chown -h)
  find "$d" -exec stat -c '%u %g %n' {} + | while read -r u g f; do
    if [ "$u" -gt 999 ] || [ "$g" -gt 999 ]; then chown -h 0:0 "$f"; fi; done
}

# ---------- package metadata + creation ----------
elf_scan(){ # prints "P soname" / "N needed"
  find "$1" -type f 2>/dev/null | while read -r f; do
    case $(file -b "$f") in *ELF*dynamic*|*ELF*shared\ object*|*ELF*pie*) ;; *) continue;; esac
    $READELF -d "$f" 2>/dev/null | awk '/\(SONAME\)/{gsub(/[\[\]]/,"",$5);print "P",$5} /\(NEEDED\)/{gsub(/[\[\]]/,"",$5);print "N",$5}'
  done | sort -u; }

lib_needed(){ # prints "N needed" for what the shared libraries (files with a SONAME) under $1 link; programs don't count
  find "$1" -type f 2>/dev/null | while read -r f; do
    case $(file -b "$f") in *ELF*dynamic*|*ELF*shared\ object*|*ELF*pie*) ;; *) continue;; esac
    $READELF -d "$f" 2>/dev/null | awk '/\(SONAME\)/{so=1} /\(NEEDED\)/{gsub(/[\[\]]/,"",$5); n[$5]} END{if (so) for (x in n) print "N", x}'
  done | sort -u; }

_has_pc(){ local d   # is the pkg-config module $1 in the sysroot or in one of this recipe's packages?
  for d in "$SYSROOT"/usr/lib/pkgconfig "$SYSROOT"/usr/share/pkgconfig "$pkgdir"/usr/lib/pkgconfig "$pkgdir"/usr/share/pkgconfig \
           "$pkgbase"/*/usr/lib/pkgconfig "$pkgbase"/*/usr/share/pkgconfig; do
    [ ! -e "$d/$1.pc" ] || return 0; done; return 1; }

make_apk(){ local sub=$1 dir=$2 desc=$3; shift 3; local deps=("$@")
  normalise "$dir"
  # a program that would look for its loader or its libraries in the build machine's sysroot must not be packaged
  if ! python3 $M/scripts/elf-unbake.py --check "$SYSROOT" "$SYSTEM_INTERP" "$dir"; then
    msg "$sub: files that name the sysroot's loader or library path (see above)"; exit 1; fi
  local scan provides=() sonames=() n
  scan=$(elf_scan "$dir")
  while read -r t so; do [ "$t" = P ] && provides+=("so:$so=0") && sonames+=("$so"); done <<< "$scan"
  while read -r t so; do [ "$t" = N ] || continue
    printf '%s\n' "${sonames[@]:-}" | grep -qxF "$so" || deps+=("so:$so"); done <<< "$scan"
  local vp; vp=$(varname "$sub"); local extra="provides_${vp}[@]"; provides+=(${!extra:-})
  # pkg-config modules: a package provides the ones it ships as pc:<name>, and depends on the ones their Requires
  # and Requires.private lines name. Installing a -dev package then brings the -dev packages its headers and link
  # line need, which a clean sysroot would otherwise lack ("Package zlib, required by libfoo, not found").
  local pc pcn req
  for pc in "$dir"/usr/lib/pkgconfig/*.pc "$dir"/usr/share/pkgconfig/*.pc; do [ -f "$pc" ] || continue
    pcn=$(basename "$pc" .pc); provides+=("pc:$pcn=$pkgver-r$pkgrel")
    for req in $(sed -n 's/^Requires\(\.private\)\{0,1\}:[ \t]*//p' "$pc" | tr ',' ' ' |
                 awk '{ for (i = 1; i <= NF; i++) { if ($i ~ /^[<>=!]+$/) { i++; continue }; sub(/[<>=!].*/, "", $i); if ($i != "") print $i } }'); do
      [ -e "$dir/usr/lib/pkgconfig/$req.pc" ] || [ -e "$dir/usr/share/pkgconfig/$req.pc" ] || {
        deps+=("pc:$req")
        # Such a module must have been in this build's sysroot, or come from this recipe. apk finds the package that
        # has it when this one is installed, but valence-build orders builds by what recipes declare: a module this
        # build never saw may be made by a recipe that comes later, and then nothing that needs this package can be
        # built until that one is (gpgme-glib.pc and glib, in the first build from an empty repository: rule 70).
        _has_pc "$req" || { msg "$sub: $pcn.pc requires $req, and neither this build's sysroot nor this recipe has $req.pc: add the -dev package that has it to makedepends"; exit 1; }; }
    done
  done
  # <pkg>-doc and <pkg>-lang install themselves next to <pkg> once "docs" or "lang" is installed (apk add docs) and
  # leave with it; a -doc package with man pages brings the program that shows them
  local iif=
  case $sub in
    "$pkgname-doc") iif="docs $pkgname=$pkgver-r$pkgrel"; [ ! -d "$dir/usr/share/man" ] || deps+=(mandoc) ;;
    "$pkgname-lang") iif="lang $pkgname=$pkgver-r$pkgrel" ;;
  esac
  local info=(-I "name:$sub" -I "version:$pkgver-r$pkgrel" -I "description:$desc" -I "arch:$ARCH"
              -I "license:$license" -I "origin:$pkgname" -I "maintainer:Valence builder <builder@valence.local>"
              -I "build-time:$(date +%s)")
  [ -n "$url" ] && info+=(-I "url:$url")
  [ ${#deps[@]} -gt 0 ] && info+=(-I "depends:$(printf '%s\n' "${deps[@]}" | sort -u | xargs)")
  [ ${#provides[@]} -gt 0 ] && info+=(-I "provides:${provides[*]}")
  [ -n "$iif" ] && info+=(-I "install-if:$iif")
  local scr=() st
  for st in pre-install post-install pre-upgrade post-upgrade pre-deinstall post-deinstall trigger; do
    [ -f "$startdir/$sub.$st" ] && scr+=(-s "$st:$startdir/$sub.$st"); done
  # triggers_<x>=(dir ...): apk runs <sub>.trigger after any transaction that changes files in those directories
  local tv="triggers_${vp}[@]" t
  for t in ${!tv:-}; do scr+=(-t "$t"); done
  if [ -f "$startdir/$sub.trigger" ] && [ -z "${!tv:-}" ]; then msg "$sub.trigger has no triggers_$vp directories"; exit 1; fi
  rm -f "$OUT/$sub"-[0-9]*.apk
  # written under a temporary name so a parallel reindex never reads a half-written package
  $APK --sign-key $KEY mkpkg -F "$dir" "${info[@]}" "${scr[@]}" -o "$OUT/.$sub.apk.tmp"
  mv "$OUT/.$sub.apk.tmp" "$OUT/$sub-$pkgver-r$pkgrel.apk"
  msg "created $sub-$pkgver-r$pkgrel.apk ($(du -h "$OUT/$sub-$pkgver-r$pkgrel.apk" | cut -f1))"
}

# subpackages first (they take files out of pkgdir)
for sp in "${subpackages[@]:-}"; do
  [ -z "$sp" ] && continue
  subpkgdir=$pkgbase/$sp; mkdir -p "$subpkgdir"; export subpkgdir
  fn=$(varname "${sp#$pkgname-}")
  if declare -F "pkg_$fn" >/dev/null; then "pkg_$fn"
  elif [ "$fn" = dev ]; then default_dev
  elif [ "$fn" = doc ]; then default_doc
  elif [ "$fn" = lang ]; then default_lang; fi
done
# ---------- docs and translations ----------
# What is still in the main package's doc and locale directories after the recipe's own split functions goes into
# $pkgname-doc and $pkgname-lang, which exist only when there is something to put in them. A recipe lists them in
# subpackages only to give them a pkg_doc()/pkg_lang() of its own. options=(keepdocs) or (keeplocale) leaves the
# files in the main package, for a package whose content they are.
_listed(){ local s; for s in "${subpackages[@]:-}"; do [ "$s" = "$1" ] && return 0; done; return 1; }
auto=()
for kind in doc lang; do
  sp=$pkgname-$kind
  _listed "$sp" && continue
  [ $kind = doc ] && has_opt keepdocs && continue
  [ $kind = lang ] && has_opt keeplocale && continue
  subpkgdir=$pkgbase/$sp; rm -rf "$subpkgdir"; mkdir -p "$subpkgdir"; export subpkgdir
  default_$kind
  if [ -n "$(find "$subpkgdir" ! -type d -print -quit)" ]; then auto+=("$sp"); else rm -rf "$subpkgdir"; fi
done
# ---------- what a -dev package needs beside it ----------
# A library's headers and CMake files pull in those of the libraries it links: Qt6Gui's want OpenGL's and xkbcommon's,
# a KDE framework's want the frameworks under it. In a clean sysroot those are only there if something asks for
# them, so every -dev package of this recipe depends on the -dev packages of the libraries this recipe's packages
# libraries link (not its programs), wherever such a -dev package was in this build's sysroot. (For libraries with a .pc file the pc: dependencies
# in make_apk say the same thing; this covers the ones found through CMake or by name.) What a header needs without
# linking it, another library's headers alone, still goes into depends_<x>_dev by hand.
linked_dev=()
if [ -f $SYSROOT/lib/apk/db/installed ]; then
  mapfile -t linked_dev < <(
    { echo "== db"; cat $SYSROOT/lib/apk/db/installed; echo "== needed"
      for _d in "$pkgdir" $(for sp in "${subpackages[@]:-}" "${auto[@]:-}"; do [ -z "$sp" ] || echo "$pkgbase/$sp"; done); do lib_needed "$_d"; done
    } | awk -v self="$pkgname" '
      $0 == "== needed" { flush(); mode = 1; next }
      $0 == "== db" { next }
      function flush(   i, n, a) {
        if (P == "") return
        if (P ~ /-dev$/) dev[O] = (O in dev ? dev[O] " " : "") P
        n = split(prov, a, " "); for (i = 1; i <= n; i++) { sub(/=.*/, "", a[i]); if (a[i] ~ /^so:/) owner[substr(a[i], 4)] = O }
        P = ""; O = ""; prov = ""
      }
      mode != 1 && /^P:/ { flush(); P = substr($0, 3); O = P; next }
      mode != 1 && /^o:/ { O = substr($0, 3); next }
      mode != 1 && /^p:/ { prov = prov " " substr($0, 3); next }
      mode == 1 && $1 == "N" { o = owner[$2]; if (o != "" && o != self && o != "glibc" && o != "gcc-runtime" && (o in dev)) print dev[o] }
    ' | tr ' ' '\n' | sort -u)
fi
for sp in "${subpackages[@]:-}" "${auto[@]:-}"; do
  [ -z "$sp" ] && continue
  v=$(varname "$sp"); d="depends_${v}[@]"; dsc="pkgdesc_${v}"
  sdeps=(${!d:-}); [[ $sp == *-dev ]] && [ -z "${!d:-}" ] && sdeps=("$pkgname=$pkgver-r$pkgrel")
  [[ $sp == *-dev ]] && [ ${#linked_dev[@]} -gt 0 ] && sdeps+=("${linked_dev[@]}")
  case $sp in "$pkgname-doc") what=documentation;; "$pkgname-lang") what=translations;; *) what=$sp;; esac
  make_apk "$sp" "$pkgbase/$sp" "${!dsc:-$pkgdesc ($what)}" "${sdeps[@]}"
done
make_apk "$pkgname" "$pkgdir" "$pkgdesc" "${depends[@]}"

# ---------- reindex ----------
# packages an earlier build of this recipe made and this one did not leave the repository first
mkdir -p "$OUT/.state"; st=$OUT/.state/$name
made=(); for sp in "${subpackages[@]:-}" "${auto[@]:-}" "$pkgname"; do [ -z "$sp" ] || made+=("$sp-$pkgver-r$pkgrel.apk"); done
if [ -f "$st" ]; then tail -n +4 "$st" | while read -r old; do
  printf '%s\n' "${made[@]}" | grep -qxF "$old" || [ ! -e "$OUT/$old" ] || { msg "removed $old (no longer made by this recipe)"; rm -f "$OUT/$old"; }
done; fi
msg "reindex"
( cd $OUT && flock .lock bash -c "$APK --keys-dir $M/keys/trusted --sign-key $KEY mkndx -d 'Valence $(date +%Y%m%d)' -o Packages.adb.new *.apk && mv Packages.adb.new Packages.adb" )

# ---------- the record scripts/valence-build reads ----------
# line 1: the recipe's fingerprint as valence-build worked it out ("by hand" when this script was run directly, which
# makes valence-build build the recipe again); line 2: BUILD_EPOCH; line 3: the version; then the package files.
# Nothing is installed into the sysroot: the next build sets up its own.
{ echo "${VALENCE_FINGERPRINT:-by hand}"; echo "$BUILD_EPOCH"; echo "$pkgver-r$pkgrel"; printf '%s\n' "${made[@]}"; } > "$st.new"
mv "$st.new" "$st"
# free the disk: build trees are large (set VALENCE_KEEP_WORK=1 to keep them for debugging)
[ "${VALENCE_KEEP_WORK:-0}" = 1 ] || rm -rf "$WORK/pkg/$name"
msg done
